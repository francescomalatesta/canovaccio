{
  "$schema": "https://opencode.ai/config.json",

  // Fallback model when neither the session nor the agent selects one.
  // Variants are not parsed from this string: set them per agent with
  // `variant` (see `agents`).
  "model": "deepseek/deepseek-flash",
  // Runs the workflows in skills/; `build` stays available for ad-hoc work.
  "default_agent": "conductor",

  "agents": {
    "build": {
      "model": "deepseek/deepseek-flash",
      "variant": "high"
    }
  },

  // Methodology/toolbox.
  // Workflows (sequencing, gates, artifacts) live in skills/workflow-*.
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.4.2"
  ],

  // Long-running autonomous sessions.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },

  // Optimized for autonomous development.
  //
  // General development operations are allowed without interruption.
  // A small set of destructive / externally consequential commands
  // still require explicit approval.
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },

    // Consequential operations remain gated.
    // Rules are matched last-wins, so these must stay after the catch-alls.
    // A trailing " *" also matches the bare command: "git push *" covers
    // "git push" too.
    {
      "action": "bash",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "bash",
      "resource": "git reset --hard *",
      "effect": "ask"
    },
    {
      "action": "bash",
      "resource": "git clean *",
      "effect": "ask"
    },
    {
      "action": "bash",
      "resource": "rm -rf *",
      "effect": "ask"
    },

    // Work stays inside the project: temporary files go to .canovaccio/tmp/
    // (see AGENTS.md). System temp directories are denied rather than asked,
    // so a stray path fails and the agent retries inside the project instead
    // of stopping for approval. Resources are canonical directories: macOS
    // resolves /tmp and $TMPDIR under /private. This covers file tools and
    // bash workdirs; paths inside a bash command are not checked.
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/var/tmp/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/private/tmp/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/private/var/tmp/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/*",
      "effect": "deny"
    },
    // Cleaning the project's own temp directory needs no approval.
    {
      "action": "bash",
      "resource": "rm -rf .canovaccio/tmp/*",
      "effect": "allow"
    }
  ]
}

