{
  "$schema": "https://opencode.ai/config.json",

  // Default controller model.
  "model": "deepseek/deepseek-flash#high",
  "default_agent": "build",

  // Methodology/toolbox.
  // Workflow-specific behavior will live elsewhere.
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.4.2"
  ],

  // Long-running autonomous sessions.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },

  // Optimized for autonomous development.
  //
  // General development operations are allowed without interruption.
  // A small set of destructive / externally consequential commands
  // still require explicit approval.
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },

    // Consequential operations remain gated.
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "ask"
    }
  ]
}

