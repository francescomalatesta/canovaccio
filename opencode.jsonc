{
  "$schema": "https://opencode.ai/config.json",

  // Fallback model when neither the session nor the agent selects one.
  // Variants are not parsed from this string: set them per agent, as
  // `provider/model#variant` (see `agents`).
  "model": "deepseek/deepseek-flash",
  // Runs the workflows in skills/; `build` stays available for ad-hoc work.
  "default_agent": "conductor",

  "agents": {
    "build": {
      "model": "deepseek/deepseek-flash#high"
    }
  },

  // Methodology/toolbox.
  // Workflows (sequencing, gates, artifacts) live in skills/workflow-*.
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.4.2"
  ],

  // Long-running autonomous sessions.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },

  // Everything is allowed: canovaccio runs in a known, protected environment
  // where everything is versioned, so no operation stops to ask for approval.
  // Pushes, pull requests and destructive operations are governed by the
  // workflows (delivery gate, Unattended delivery in workflow-rules), not by
  // permission prompts.
  //
  // Agent files narrow this with denies of their own (reviewers do not edit,
  // subagents do not dispatch subagents or ask questions).
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },

    // Work stays inside the project: temporary files go to .canovaccio/tmp/
    // (see AGENTS.md). System temp directories are denied, which never asks:
    // a stray path fails and the agent retries inside the project. Resources
    // are canonical directories: macOS resolves /tmp and $TMPDIR under
    // /private. This covers file tools and shell workdirs; paths inside a
    // shell command are not checked.
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/var/tmp/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/private/tmp/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/private/var/tmp/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/*",
      "effect": "deny"
    }
  ]
}
